# 依赖与包管理器缓存
node_modules/
.pnpm-store/

# 构建产物（tsdown / Vite）
dist/
*.tsbuildinfo
*.tgz

# 测试与覆盖率产物
coverage/

# 本地环境变量与凭据（示例文件保持可提交）
.env
.env.*
!.env*.example

# 本地运行数据：发行缓存与回放文件
# 仅忽略仓库根目录，避免误伤游戏包内同名的 data/ 或 replays/ 目录
/data/
/replays/

# 本地工具临时目录
.zcode/
.workbuddy/
.codex/

# 日志与编辑器临时文件
*.log
*.orig
*.rej
.idea/
.vscode/

# 操作系统文件
.DS_Store
._*
