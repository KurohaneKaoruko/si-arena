{
  "name": "si-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel run dev",
    "dev:web": "pnpm build:packages && pnpm --filter @si-arena/web dev",
    "dev:server": "pnpm build:packages && pnpm --filter @si-arena/server dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @si-arena/worker dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:packages": "pnpm -r --filter './packages/**' --filter './games/**' --workspace-concurrency=1 run build",
    "typecheck": "pnpm build:packages && pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm build:packages && pnpm --filter @si-arena/server build && pnpm -r --if-present run test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "arena": "node packages/cli/dist/main.js",
    "db:generate": "pnpm --filter @si-arena/server db:generate",
    "db:migrate": "pnpm --filter @si-arena/server db:migrate",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,yaml,yml,css,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.14.0"
}
