{
  "name": "@si-arena/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx ../../scripts/wait-for-workspace-deps.ts && node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "tsdown --config ../../tsdown.config.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner --config ../../vitest.config.ts --project worker"
  },
  "dependencies": {
    "@si-arena/db": "workspace:*",
    "@si-arena/engine": "workspace:*",
    "@si-arena/game-paper": "workspace:*",
    "@si-arena/protocol": "workspace:*",
    "@si-arena/sandbox": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
