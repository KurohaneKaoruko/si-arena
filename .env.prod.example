# 生产部署配置：复制为 .env.prod 并填写真实值（.env.prod 已被 git 忽略）。
# 所有命令都需显式携带：docker compose --env-file .env.prod -f compose.prod.yaml <命令>

# 必填：数据库强密码。用 openssl rand -hex 24 生成：base64 输出常含 + / =，
# 会被原样拼进 DATABASE_URL 导致连接串非法（迁移与服务启动直接失败）。
POSTGRES_PASSWORD=change-me

# 对外域名：Caddy 据此自动申请并续期 TLS 证书；留空则只监听 80 端口（本地试用）。
CADDY_DOMAIN=arena.example.com

# 可选：caddy 发布的宿主端口（默认 80/443）。与其他服务共机时改用空闲高位端口，
# 如 HTTP_PORT=8082 与 HTTPS_PORT=8443——两个都要换，任一仍占 80/443 都会绑定冲突。
# 非标准端口下 Let's Encrypt 的挑战流量到不了容器，CADDY_DOMAIN 必须留空走纯 HTTP，
# HTTPS_PORT 仅为占位发布，不产生流量。
# HTTP_PORT=80
# HTTPS_PORT=443

# 可选项：server 日志级别、worker 并发比赛数。
LOG_LEVEL=info
WORKER_CONCURRENCY=2
