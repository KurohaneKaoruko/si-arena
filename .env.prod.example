# 生产部署配置：复制为 .env.prod 并填写真实值（.env.prod 已被 git 忽略）。
# 所有命令都需显式携带：docker compose --env-file .env.prod -f compose.prod.yaml <命令>

# 必填：数据库强密码（建议 openssl rand -base64 24 生成）。
POSTGRES_PASSWORD=change-me

# 对外域名：Caddy 据此自动申请并续期 TLS 证书；留空则只监听 80 端口（本地试用）。
CADDY_DOMAIN=arena.example.com

# 可选项：server 日志级别、worker 并发比赛数。
LOG_LEVEL=info
WORKER_CONCURRENCY=2
