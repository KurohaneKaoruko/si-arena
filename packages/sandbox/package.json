{
  "name": "@si-arena/sandbox",
  "version": "0.3.0",
  "license": "MIT",
  "author": {
    "name": "lovekeqing",
    "email": "2911331070@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovezhangchuangxin/si-arena.git",
    "directory": "packages/sandbox"
  },
  "files": [
    "dist",
    "runtime",
    "native"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "node native/build.mjs",
    "build": "tsdown --config ../../tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsdown --config ../../tsdown.config.ts --watch",
    "prepack": "pnpm build",
    "test": "vitest run --configLoader runner --config ../../vitest.config.ts --project sandbox",
    "benchmark": "pnpm build && node native/benchmark.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "catalog:",
    "@si-arena/protocol": "workspace:*",
    "acorn": "catalog:",
    "quickjs-emscripten-core": "catalog:"
  },
  "devDependencies": {
    "tsx": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
