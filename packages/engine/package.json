{
  "name": "@si-arena/engine",
  "version": "0.0.0",
  "files": [
    "dist",
    "examples"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsdown --config ../../tsdown.config.ts --watch",
    "prepack": "pnpm build",
    "test": "vitest run --configLoader runner --config ../../vitest.config.ts --project engine",
    "example:paper": "node examples/paper-match.mjs"
  },
  "dependencies": {
    "@si-arena/protocol": "workspace:*"
  },
  "devDependencies": {
    "@si-arena/game-paper": "workspace:*",
    "@si-arena/sandbox": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  }
}
