{
  "name": "@si-arena/protocol",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsdown --config ../../tsdown.config.ts --watch",
    "test": "vitest run --configLoader runner --config ../../vitest.config.ts --project protocol",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=26"
  }
}
