  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovezhangchuangxin/si-arena.git",
    "directory": "packages/player"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsdown --config ../../tsdown.config.ts --watch",
    "prepack": "pnpm build",
    "test": "vitest run --configLoader runner --config ../../vitest.config.ts --project player --project player-browser"
  },
  "dependencies": {
    "@si-arena/engine": "workspace:*",
    "@si-arena/protocol": "workspace:*"
  },
  "devDependencies": {
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=26"
  }
}
