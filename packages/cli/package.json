{
  "name": "@si-arena/cli",
  "version": "0.0.0",
  "bin": {
    "arena": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsdown --config ../../tsdown.config.ts --watch",
    "prepack": "pnpm build",
    "test": "vitest run --configLoader runner --config ../../vitest.config.ts --project cli"
  },
  "dependencies": {
    "@si-arena/engine": "workspace:*",
    "@si-arena/protocol": "workspace:*",
    "@si-arena/sandbox": "workspace:*",
    "fflate": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
